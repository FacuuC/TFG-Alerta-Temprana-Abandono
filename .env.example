# Copiá este archivo como .env (o generalo con: python scripts/crear_env.py).
# .env tiene secretos: nunca se sube al repositorio.

ENTORNO=desarrollo

# Base de datos
POSTGRES_USER=alerta
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=alerta_temprana
# En desarrollo local la aplicación se conecta a localhost; en Docker, compose usa "db".
DB_HOST=localhost
DB_PORT=5432

# Clave secreta del HMAC que genera los códigos seudonimizados (HU-001)
SEUDONIMO_CLAVE=cambiar-por-una-clave-larga-y-aleatoria

# Parámetros metodológicos (valores del documento)
SEMILLA=42
CAPACIDAD_TUTORIAS=0.15
DETECCION_MINIMA=0.80
AUC_MINIMO_CIERRE_1S=0.80
