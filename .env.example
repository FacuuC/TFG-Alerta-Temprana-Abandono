# Copiá este archivo como .env (o generalo con: python scripts/crear_env.py).
# .env tiene secretos: nunca se sube al repositorio. Reemplazá los dos valores «cambiar…»
# por valores aleatorios (README, «Manual de instalación», paso 2).

ENTORNO=desarrollo

# Base de datos. La contraseña se fija la primera vez que se crea el volumen datos_db;
# usá solo letras, dígitos, «-» y «_».
POSTGRES_USER=alerta
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=alerta_temprana
# DB_HOST y DB_PORT los usan solo los procesos fuera de Docker (pruebas, scripts y uvicorn),
# con la base publicada por compose.dev.yaml. En Docker, compose.yaml usa "db" y 5432.
# Usá 127.0.0.1 y no «localhost»: en Windows, «localhost» prueba primero IPv6 y la
# primera conexión puede tardar minutos (la base se publica solo en 127.0.0.1).
# Si el 5432 está ocupado, usá otro puerto (por ejemplo, 15432).
DB_HOST=127.0.0.1
DB_PORT=5432

# Clave secreta del HMAC que genera los códigos seudonimizados (HU-001, decisión P1).
# Cualquier valor largo y aleatorio. Con otra clave cambian los códigos EST-, pero no las
# probabilidades, los niveles ni las cantidades.
SEUDONIMO_CLAVE=cambiar-por-una-clave-larga-y-aleatoria

# Parámetros metodológicos (valores del documento)
SEMILLA=42
CAPACIDAD_TUTORIAS=0.15
DETECCION_MINIMA=0.80
AUC_MINIMO_CIERRE_1S=0.80
